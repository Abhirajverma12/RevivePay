{
  "name": "revivepay",
  "version": "0.1.0",
  "private": true,
  "description": "RevivePay - Razorpay AI Buildathon AI Revenue Recovery Engine",
  "workspaces": [
    "apps/*",
    "simulator",
    "agent",
    "workers"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces",
    "dev:api": "npm --workspace=apps/api run start:dev",
    "dev:web": "npm --workspace=apps/web run dev",
    "build": "npm run build --workspaces",
    "build:api": "npm --workspace=apps/api run build",
    "build:web": "npm --workspace=apps/web run build",
    "build:backend": "npx prisma generate && npm run build:api",
    "start:backend": "node apps/api/dist/main.js",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "prisma:generate": "npx prisma generate",
    "prisma:migrate": "npx prisma migrate dev",
    "prisma:seed": "node prisma/seed.js",
    "demo:seed": "node prisma/seed.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "keywords": [
    "revenue-recovery",
    "ai-agent",
    "razorpay",
    "hackathon"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@nestjs/cli": "^10.4.8",
    "@types/node": "^22.10.1",
    "bullmq": "^6.3.4",
    "ioredis": "^6.0.0",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "zod": "^4.5.4"
  }
}
